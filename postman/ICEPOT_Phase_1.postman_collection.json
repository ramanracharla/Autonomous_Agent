{
  "info": {
    "_postman_id": "d33ea5c0-50fa-4c0e-8724-11ce907a0001",
    "name": "ICEPOT - Phase 1 Foundation",
    "description": "Phase 1 gateway smoke test. Start the application with Docker Compose before running the request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Confirms that the ICEPOT API gateway is reachable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('reports gateway as UP', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('success', true);",
              "    pm.expect(body).to.have.property('service', 'icepot-api-gateway');",
              "    pm.expect(body).to.have.property('status', 'UP');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
